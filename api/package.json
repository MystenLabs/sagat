{
	"name": "sagat-api",
	"scripts": {
		"dev": "bun run --hot src/index.ts",
		"build": "bun build src/index.ts src/db/migrate-cli.ts --outdir dist --target bun",
		"test:e2e": "bun test --parallel=4 --timeout 30000 ./test/*.test.ts",
		"test:migrations": "bun test ./test/migrations",
		"test:watch": "bun test --watch",
		"db:generate": "bun drizzle-kit generate",
		"db:migrate": "bun drizzle-kit migrate",
		"db:migrate:prod": "bun run src/db/migrate-cli.ts",
		"db:prepare": "bun run scripts/prepare-db.ts",
		"fmt": "prettier --write ."
	},
	"dependencies": {
		"@mysten/sagat": "workspace:*",
		"@mysten/sui": "^2.37.0",
		"dataloader": "^2.2.3",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.11",
		"jose": "^6.2.12",
		"pg": "^8.23.0",
		"prom-client": "^15.1.3"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"prettier": "^3.9.9"
	}
}
