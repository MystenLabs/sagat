{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"outputDirectory": "out",
	"cleanUrls": true,
	"trailingSlash": false,
	"headers": [
		{
			"source": "/_next/static/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=31536000, immutable"
				}
			]
		}
	]
}
